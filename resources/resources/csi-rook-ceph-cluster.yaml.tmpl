---
# CephCluster, CephBlockPool, and StorageClass for Rook-Ceph.
#
# This manifest creates the actual Ceph cluster after the Rook operator
# has been deployed via the HelmChart CRD.
#
# The operator (deployed from csi-rook-ceph-chart.yaml) handles all the
# CRDs, RBAC, and operator Deployment. This manifest just defines the
# desired Ceph cluster configuration.
#
# References:
# - https://rook.io/docs/rook/latest/CRDs/Cluster/ceph-cluster-crd/
# - https://rook.io/docs/rook/latest/Getting-Started/example-configurations/
---
apiVersion: ceph.rook.io/v1
kind: CephCluster
metadata:
  name: rook-ceph
  namespace: rook-ceph
spec:
  # Ceph version to deploy (image pre-loaded from tarball).
  cephVersion:
    image: quay.io/ceph/ceph:v18.2.4
    allowUnsupported: false
  
  # Data directory on host for Ceph storage.
  # This directory will be created automatically by privileged Ceph daemon pods.
  dataDirHostPath: /var/lib/rook
  
  # Skip upgrade checks for initial deployment.
  skipUpgradeChecks: false
  
  # Continue if upgrade checks fail (not recommended for production).
  continueUpgradeAfterChecksEvenIfNotHealthy: false
  
  # Wait timeout for healthy OSD before proceeding with upgrade.
  waitTimeoutForHealthyOSDInMinutes: 10
  
  # Mon configuration (3 mons for production quorum).
  mon:
    count: 3
    allowMultiplePerNode: true  # Required for single-node clusters
  
  # Manager configuration.
  mgr:
    count: 1
    allowMultiplePerNode: false
    modules:
      - name: pg_autoscaler
        enabled: true
  
  # Dashboard disabled by default (enable via helm values if needed).
  dashboard:
    enabled: false
  
  # Monitoring disabled by default.
  monitoring:
    enabled: false
  
  # Network configuration.
  network:
    # Use host networking for better performance.
    provider: host
  
  # Crash collector to gather crash reports.
  crashCollector:
    disable: false
  
  # Log collector disabled to reduce resource usage.
  logCollector:
    enabled: false
  
  # Cleanup policy - keep data on cluster deletion.
  cleanupPolicy:
    confirmation: ""
    sanitizeDisks:
      method: quick
      dataSource: zero
      iteration: 1
    allowUninstallWithVolumes: false
  
  # Storage configuration - use all available devices.
  storage:
    useAllNodes: true
    useAllDevices: true
    
    # Device filter to include/exclude devices.
    # deviceFilter: "^sd[b-z]"  # Uncomment to only use sdb, sdc, etc.
    
    config:
      # OSD objectstore type (bluestore is default and recommended).
      storeType: bluestore
      
      # Database size for OSDs (optional, auto-sized by default).
      # databaseSizeMB: "1024"
      
      # Journal size for OSDs (optional, auto-sized by default).
      # journalSizeMB: "1024"
  
  # Resource requests/limits for Ceph daemons.
  resources:
    mon:
      limits:
        memory: "1Gi"
      requests:
        cpu: "500m"
        memory: "512Mi"
    mgr:
      limits:
        memory: "1Gi"
      requests:
        cpu: "500m"
        memory: "512Mi"
    osd:
      limits:
        memory: "4Gi"
      requests:
        cpu: "1000m"
        memory: "2Gi"
  
  # Placement for Ceph daemons (allow on all nodes).
  placement:
    all:
      tolerations:
        - operator: Exists
  
  # Priority class for Ceph pods.
  priorityClassNames:
    all: system-cluster-critical
    mon: system-node-critical
    mgr: system-cluster-critical
    osd: system-node-critical

---
# CephBlockPool for RBD (RADOS Block Device) storage.
apiVersion: ceph.rook.io/v1
kind: CephBlockPool
metadata:
  name: replicapool
  namespace: rook-ceph
spec:
  # Failure domain - host level for multi-node, osd level for single-node.
  failureDomain: host
  
  # Replication configuration (3 replicas for production).
  replicated:
    size: 3
    requireSafeReplicaSize: true
  
  # Enable RBD mirroring (optional, disabled by default).
  mirroring:
    enabled: false

---
# StorageClass for dynamic PVC provisioning with Rook-Ceph RBD.
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: rook-ceph-block
  annotations:
    storageclass.kubernetes.io/is-default-class: "true"
provisioner: rook-ceph.rbd.csi.ceph.com
parameters:
  clusterID: rook-ceph
  pool: replicapool
  imageFormat: "2"
  imageFeatures: layering
  csi.storage.k8s.io/provisioner-secret-name: rook-csi-rbd-provisioner
  csi.storage.k8s.io/provisioner-secret-namespace: rook-ceph
  csi.storage.k8s.io/controller-expand-secret-name: rook-csi-rbd-provisioner
  csi.storage.k8s.io/controller-expand-secret-namespace: rook-ceph
  csi.storage.k8s.io/node-stage-secret-name: rook-csi-rbd-node
  csi.storage.k8s.io/node-stage-secret-namespace: rook-ceph
  csi.storage.k8s.io/fstype: ext4
reclaimPolicy: Retain
allowVolumeExpansion: true
mountOptions: []
