# Cilium HelmChartConfig for RKE2
# This configures Cilium to replace kube-proxy for service load balancing.
#
# See: https://docs.rke2.io/networking/basic_network_options
# See: https://docs.cilium.io/en/stable/network/kubernetes/kubeproxy-free/
---
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  valuesContent: |-
    # Enable Cilium kube-proxy replacement.
    # This allows Cilium to handle service load balancing via eBPF instead of iptables.
    kubeProxyReplacement: true

    # Enable Hubble for network observability.
    hubble:
      enabled: true
      relay:
        enabled: true
      ui:
        enabled: true
