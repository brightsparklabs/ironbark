#!/usr/bin/env bash

##
 # Wrapper to launch Ironbark.
 #
 # Image:            {{ .Image }}
 # Container engine: {{ .Engine }}
 # _____________________________________________________________________________
 #
 # Generated by 'ironbark generate launcher' at {{ .GeneratedAt }}.
 #   Ironbark version:    {{ .IronbarkVersion }}
 #   Ironbark commit:     {{ .IronbarkCommit }}
 #   Ironbark build time: {{ .IronbarkBuildTime }}
 #
 # Created by brightSPARK Labs.
 # www.brightsparklabs.com.
 ##

# ------------------------------------------------------------------------------
# EXIT CONDITIONS
# ------------------------------------------------------------------------------

# Exit script on error.
set -o errexit
# Exit if using undeclared variables.
set -o nounset
# Exit if pipe fails.
set -o pipefail

# ------------------------------------------------------------------------------
# VARIABLES
# ------------------------------------------------------------------------------
#
# Pre-declare every runtime setting so it is defined-but-empty by the
# time 'set -o nounset' starts watching, while preserving any value the
# operator already exported. 'init_runtime_settings' (called from
# 'main' after 'parse_launcher_args') substitutes the baked-in defaults
# for any variable that is still empty after CLI-flag parsing.

: "${IRONBARK_SCRIPT_CONTAINER_ENGINE:=}"
: "${IRONBARK_SCRIPT_IMAGE:=}"
: "${IRONBARK_SCRIPT_NO_INTERACTIVE:=}"
: "${IRONBARK_SCRIPT_NO_TTY:=}"
: "${IRONBARK_SCRIPT_VERBOSE:=}"
: "${IRONBARK_HOST_DATA_DIR:=}"
: "${IRONBARK_HOST_KUBECONFIG:=}"

# Container engine arguments destined for the Ironbark container.
# Populated by 'parse_launcher_args' from the launcher's '"$@"'.
CONTAINER_ARGS=()

# ------------------------------------------------------------------------------
# FUNCTIONS
# ------------------------------------------------------------------------------

##
 # Prints an informational message to stderr.
 #
 # @param $*
 #          The message to print.
 ##
function print_info() { echo "$(date -Iseconds) INFO: $*" >&2; }

##
 # Prints an error message to stderr.
 #
 # @param $*
 #          The error message to print.
 ##
function print_error() { echo "$(date -Iseconds) ERROR: $*" >&2; }

##
 # Prints a verbose-mode debug message to stderr if
 # 'IRONBARK_SCRIPT_VERBOSE' is defined.
 #
 # @param $*
 #          The message to print.
 ##
function print_verbose() {
    [[ -n "${IRONBARK_SCRIPT_VERBOSE}" ]] && echo "$(date -Iseconds) DEBUG: $*" >&2
    return 0
}

##
 # Prints launcher usage information to stderr.
 ##
function print_launcher_usage() {
    cat >&2 <<EOF
Usage: $(basename "$0") [LAUNCHER_OPTIONS] [-- IRONBARK_ARGS...]

If a literal '--' separator is supplied, every argument BEFORE the '--' is
parsed by the launcher itself and every argument AFTER the '--' is forwarded
verbatim to the Ironbark container. If no '--' is supplied, ALL arguments
are forwarded to the container unchanged (no launcher-flag parsing happens).

Launcher options (only honoured when a '--' separator is present):
  --no-interactive        Run the container without '--interactive' (sets IRONBARK_SCRIPT_NO_INTERACTIVE=true).
  --no-tty                Run the container without '--tty' (sets IRONBARK_SCRIPT_NO_TTY=true).
  --verbose               Print launcher diagnostics to stderr (sets IRONBARK_SCRIPT_VERBOSE=true).
  --container-engine=ENG  Override the container engine (sets IRONBARK_SCRIPT_CONTAINER_ENGINE).
  --image=IMG             Override the container image (sets IRONBARK_SCRIPT_IMAGE).
  --help                  Print this help message and exit.

Equivalent IRONBARK_SCRIPT_* environment variables can also be exported
directly; the CLI flags above are convenience wrappers that set them
before the launcher reads them.
EOF
}

##
 # Parses launcher-specific options from the supplied arguments and exports
 # the corresponding 'IRONBARK_SCRIPT_*' environment variables so the rest
 # of the script picks them up.
 #
 # The arguments destined for the Ironbark container are written into the
 # global array 'CONTAINER_ARGS'. We use a global rather than stdout so
 # this function can both (a) export env vars and (b) return the forwarded
 # args without a subshell (process substitution would discard the env
 # var exports).
 #
 # If a literal '--' is found, only arguments BEFORE it are parsed; the
 # arguments AFTER '--' become 'CONTAINER_ARGS'.
 #
 # If no '--' is present, NO arguments are parsed and ALL arguments become
 # 'CONTAINER_ARGS' verbatim. This preserves backwards compatibility with
 # callers that just want to forward everything to the container.
 #
 # @param $@
 #          The full argument list passed to the launcher.
 ##
function parse_launcher_args() {
    CONTAINER_ARGS=()

    local has_separator="false"
    local arg
    for arg in "$@"; do
        if [[ "${arg}" == "--" ]]; then
            has_separator="true"
            break
        fi
    done

    # No separator: forward everything verbatim, parse nothing.
    if [[ "${has_separator}" == "false" ]]; then
        CONTAINER_ARGS=("$@")
        return 0
    fi

    # Separator present: consume launcher flags up to '--', then collect
    # everything after '--' into 'CONTAINER_ARGS'.
    while (( $# > 0 )); do
        case "$1" in
            --)
                shift
                break
                ;;
            --help)
                print_launcher_usage
                exit 0
                ;;
            --no-interactive)
                export IRONBARK_SCRIPT_NO_INTERACTIVE="true"
                ;;
            --no-tty)
                export IRONBARK_SCRIPT_NO_TTY="true"
                ;;
            --verbose)
                export IRONBARK_SCRIPT_VERBOSE="true"
                ;;
            --container-engine=*)
                export IRONBARK_SCRIPT_CONTAINER_ENGINE="${1#*=}"
                ;;
            --image=*)
                export IRONBARK_SCRIPT_IMAGE="${1#*=}"
                ;;
            *)
                print_error "Unknown launcher option: $1"
                print_launcher_usage
                exit 2
                ;;
        esac
        shift
    done

    CONTAINER_ARGS=("$@")
}

##
 # Initialises every runtime setting from the corresponding
 # 'IRONBARK_SCRIPT_*' environment variable, falling back to the default
 # baked into the script at generation time. Must be called AFTER
 # 'parse_launcher_args' so that any CLI-flag overrides take effect.
 ##
function init_runtime_settings() {
    # Container engine to use ('podman' or 'docker').
    IRONBARK_SCRIPT_CONTAINER_ENGINE="${IRONBARK_SCRIPT_CONTAINER_ENGINE:-{{ .Engine }}}"

    # Container image to launch.
    IRONBARK_SCRIPT_IMAGE="${IRONBARK_SCRIPT_IMAGE:-{{ .Image }}}"

    # Host directory which holds Ironbark application data.
    # Mounted into the container at '/mnt/data' and re-exposed inside the
    # container as 'IRONBARK_HOST_DATA_DIR' so Ironbark can correctly
    # reference files on the host (e.g. when invoking nested container
    # engines).
    IRONBARK_HOST_DATA_DIR="${IRONBARK_HOST_DATA_DIR:-{{ .HostDataDir }}}"

    # Host kubeconfig file to mount into the container.
    IRONBARK_HOST_KUBECONFIG="${IRONBARK_HOST_KUBECONFIG:-{{ .HostKubeconfig }}}"

    # Disable the container engine '--interactive' flag.
    # Define 'IRONBARK_SCRIPT_NO_INTERACTIVE' to ANY value to disable.
{{ if .NoInteractive -}}
    IRONBARK_SCRIPT_NO_INTERACTIVE="${IRONBARK_SCRIPT_NO_INTERACTIVE:-true}"
{{- end }}

    # Disable the container engine '--tty' flag.
    # Define 'IRONBARK_SCRIPT_NO_TTY' to ANY value to disable.
{{ if .NoTTY -}}
    IRONBARK_SCRIPT_NO_TTY="${IRONBARK_SCRIPT_NO_TTY:-true}"
{{- end }}
}

##
 # Captures details about the host invoking the launcher and emits them as
 # '--env KEY=VALUE' arguments suitable for splatting into a container engine
 # invocation. This allows code inside the container to reason about the host
 # environment (e.g. to chown files back to the invoking user, or to launch
 # further containers via the host engine).
 ##
function host_env_args() {
    local host_user host_uid host_gid host_hostname host_pwd host_os host_arch

    host_user="${SUDO_USER:-${USER:-unknown}}"
    host_uid="${SUDO_UID:-$(id -u)}"
    host_gid="${SUDO_GID:-$(id -g)}"
    host_hostname="$(hostname 2>/dev/null || echo unknown)"
    host_pwd="${PWD}"
    host_os="$(uname -s 2>/dev/null || echo unknown)"
    host_arch="$(uname -m 2>/dev/null || echo unknown)"

    # Note: 'IRONBARK_IN_CONTAINER=true' is baked into the Ironbark image at
    # build time, so it is intentionally not re-emitted here. Forwarding it
    # again would mask the image-level guarantee and make it possible for a
    # caller to override it from outside the container.

    # Sentinel indicating Ironbark was invoked via the launcher (rather than
    # ad-hoc 'podman run'). Code can use this to detect launcher invocation
    # AND to enforce that every expected 'IRONBARK_HOST_*' variable below
    # is present.
    printf -- '--env IRONBARK_LAUNCHER_INVOKED=true '

    # Launcher provenance (helps debug stale wrappers).
    printf -- '--env IRONBARK_HOST_LAUNCHER_VERSION={{ .IronbarkVersion }} '
    printf -- '--env IRONBARK_HOST_LAUNCHER_COMMIT={{ .IronbarkCommit }} '
    printf -- '--env IRONBARK_HOST_LAUNCHER_BUILD_TIME={{ .IronbarkBuildTime }} '
    printf -- '--env IRONBARK_HOST_LAUNCHER_GENERATED_AT={{ .GeneratedAt }} '

    # Host identity.
    printf -- '--env IRONBARK_HOST_USER=%q ' "${host_user}"
    printf -- '--env IRONBARK_HOST_UID=%q ' "${host_uid}"
    printf -- '--env IRONBARK_HOST_GID=%q ' "${host_gid}"
    printf -- '--env IRONBARK_HOST_HOSTNAME=%q ' "${host_hostname}"

    # Host context.
    printf -- '--env IRONBARK_HOST_PWD=%q ' "${host_pwd}"
    printf -- '--env IRONBARK_HOST_OS=%q ' "${host_os}"
    printf -- '--env IRONBARK_HOST_ARCH=%q ' "${host_arch}"

    # Mounted paths (so nested container invocations can re-mount them).
    printf -- '--env IRONBARK_HOST_DATA_DIR=%q ' "${IRONBARK_HOST_DATA_DIR}"
    printf -- '--env IRONBARK_HOST_KUBECONFIG=%q ' "${IRONBARK_HOST_KUBECONFIG}"

    # Container engine context.
    printf -- '--env IRONBARK_HOST_CONTAINER_ENGINE=%q ' "${IRONBARK_SCRIPT_CONTAINER_ENGINE}"
}

##
 # Entry point.
 #
 # @param $@
 #          The command line arguments to forward to the Ironbark container.
 ##
function main() {
    # Parse launcher-specific CLI flags (everything before a literal '--').
    # If no '--' is supplied, all arguments are treated as container args
    # and forwarded verbatim. The forwarded args are placed in the global
    # 'CONTAINER_ARGS' array - we use a global rather than capturing
    # stdout because exports performed inside a process substitution
    # would not propagate back to this shell.
    parse_launcher_args "$@"

    # Initialise runtime settings AFTER flag parsing so any
    # 'IRONBARK_SCRIPT_*' env vars exported by 'parse_launcher_args' take
    # effect.
    init_runtime_settings

    # Attempt to create the host data directory if it does not exist; if the
    # creation fails (e.g. permission denied) report the underlying error and
    # exit so misconfiguration surfaces immediately.
    if [[ ! -d "${IRONBARK_HOST_DATA_DIR}" ]]; then
        print_info "Host data directory does not exist; creating: ${IRONBARK_HOST_DATA_DIR}"
        if ! mkdir -p "${IRONBARK_HOST_DATA_DIR}"; then
            print_error "Could not create host data directory: ${IRONBARK_HOST_DATA_DIR}"
            exit 1
        fi
    fi

    # Build the optional flags based on environment overrides.
    # If the disable variable is defined to ANY value, the corresponding flag
    # is omitted; leave the variable unset to keep the flag enabled.
    local interactive_flag="--interactive"
    [[ -n "${IRONBARK_SCRIPT_NO_INTERACTIVE}" ]] && interactive_flag=""

    local tty_flag="--tty"
    [[ -n "${IRONBARK_SCRIPT_NO_TTY}" ]] && tty_flag=""

    if [[ -n "${IRONBARK_SCRIPT_VERBOSE}" ]]; then
        local _v
        # Print the resolved value of each runtime setting, one per
        # row, with columns aligned on the longest variable name
        # ('IRONBARK_SCRIPT_CONTAINER_ENGINE' at 32 chars).
        print_verbose "Resolved launcher settings (after CLI-flag and env-var overrides):"
        local _setting
        for _setting in IRONBARK_SCRIPT_CONTAINER_ENGINE \
                        IRONBARK_SCRIPT_IMAGE \
                        IRONBARK_SCRIPT_NO_INTERACTIVE \
                        IRONBARK_SCRIPT_NO_TTY \
                        IRONBARK_SCRIPT_VERBOSE \
                        IRONBARK_HOST_DATA_DIR \
                        IRONBARK_HOST_KUBECONFIG; do
            printf -v _v '  %-34s = %q' "${_setting}" "${!_setting-}"
            print_verbose "${_v}"
        done
        # Derived flags (computed from the IRONBARK_SCRIPT_NO_* settings).
        printf -v _v '  %-34s = %s' "(derived) --interactive flag" \
            "$([[ -n "${interactive_flag}" ]] && echo enabled || echo disabled)"
        print_verbose "${_v}"
        printf -v _v '  %-34s = %s' "(derived) --tty flag" \
            "$([[ -n "${tty_flag}" ]] && echo enabled || echo disabled)"
        print_verbose "${_v}"

        print_verbose "Forwarded host env vars:"
        # 'host_env_args' produces a stream of '--env KEY=VALUE' tokens.
        # Re-format them one-per-line for readability.
        local arg
        for arg in $(host_env_args); do
            [[ "${arg}" == "--env" ]] && continue
            print_verbose "  ${arg}"
        done

        # Show the args that will be forwarded to the Ironbark
        # container so the operator can confirm the launcher consumed
        # the launcher-only flags (and only the launcher-only flags).
        if (( ${#CONTAINER_ARGS[@]} > 0 )); then
            print_verbose "Container args (forwarded verbatim to image):"
            local i
            for (( i = 0; i < ${#CONTAINER_ARGS[@]}; i++ )); do
                printf -v _v '  argv[%d] = %q' "${i}" "${CONTAINER_ARGS[${i}]}"
                print_verbose "${_v}"
            done
        else
            print_verbose "Container args: (none - the image's default CMD will run)"
        fi
    fi

    # 'host_env_args' is intentionally unquoted so each '--env KEY=VALUE'
    # token is passed as a separate argument to the container engine.
    # 'CONTAINER_ARGS' is quoted so individual args containing whitespace
    # are preserved as a single token each. The '+' parameter expansion
    # avoids triggering 'nounset' on an empty array under older bash.
    # shellcheck disable=SC2046
    # Mount the host kubeconfig at a launcher-owned, predictable path and
    # set 'KUBECONFIG' so every tool inside the container (kubectl, helm,
    # zarf, ironbark) consults the same file.
    "${IRONBARK_SCRIPT_CONTAINER_ENGINE}" run \
        --rm \
        ${interactive_flag} \
        ${tty_flag} \
        --network=host \
        $(host_env_args) \
        --env KUBECONFIG=/mnt/conf/kubeconfig \
        --volume "${IRONBARK_HOST_KUBECONFIG}:/mnt/conf/kubeconfig:z" \
        --volume "${IRONBARK_HOST_DATA_DIR}:/mnt/data:z" \
        "${IRONBARK_SCRIPT_IMAGE}" \
        ${CONTAINER_ARGS[@]+"${CONTAINER_ARGS[@]}"}
}

# ------------------------------------------------------------------------------
# LOGIC
# ------------------------------------------------------------------------------

main "$@"
