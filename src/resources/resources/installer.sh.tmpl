#!/usr/bin/env bash

##
 # Installs Ironbark for the `{{ .ReleaseEnvironment }}` release environment.
 #
 # Generated by Ironbark version [{{ .IronbarkVersion }}] (commit [{{ .IronbarkCommit }}], built [{{ .IronbarkBuildTime }}]) at [{{ .GeneratedAt }}].
 #
 # When piped through `bash`, this script will:
 #   - Create the per-environment install directory tree under:
 #         {{ .InstallDir }}/
 #     including the default subdirectories:
 #         - bin/
 #         - data/zarf/init/
 #         - data/repos/
 #   - Restore ownership of the install tree to the invoking user/group
 #     (`SUDO_USER` falling back to `USER`), so subsequent runs do not
 #     require root.
 #   - If `setfacl` is available, set recursive default ACLs on
 #     `{{ .InstallBaseDir }}/` granting the invoking user/group rwx so
 #     future files created beneath it inherit the right permissions.
 #   - Write a versioned launcher script
 #         {{ .InstallDir }}/bin/.<timestamp>_ironbark_{{ .IronbarkVersion }}
 #     and symlink the generic `bin/ironbark` launcher to point at it.
 #
 # The launcher itself is the standard Ironbark launcher (equivalent to
 # `ironbark generate launcher`) inlined below.
 #
 # ____________________________________________________________________________
 #
 # Created by brightSPARK Labs.
 # www.brightsparklabs.com
 ##

# ------------------------------------------------------------------------------
# EXIT CONDITIONS
# ------------------------------------------------------------------------------

# Exit script on error.
set -o errexit
# Exit if using undeclared variables.
set -o nounset
# Exit if pipe fails.
set -o pipefail

# ------------------------------------------------------------------------------
# CONSTANTS (baked in at generation time)
# ------------------------------------------------------------------------------

# Base install directory (without release-environment suffix).
readonly IRONBARK_INSTALL_BASE_DIR="{{ .InstallBaseDir }}"

# Release environment this installer targets (e.g. `production`, `staging`).
readonly IRONBARK_RELEASE_ENVIRONMENT="{{ .ReleaseEnvironment }}"

# Final per-environment install directory.
readonly IRONBARK_INSTALL_DIR="{{ .InstallDir }}"

# Ironbark version baked into the launcher embedded below.
readonly IRONBARK_VERSION="{{ .IronbarkVersion }}"

# Subdirectory beneath the install directory which holds the versioned
# launcher script and the generic `ironbark` symlink.
readonly IRONBARK_BIN_DIR="${IRONBARK_INSTALL_DIR}/bin"

# Default subdirectories created beneath the install directory.
# These map to the Ironbark conventions for the launcher, Zarf assets
# and Git repos.
readonly IRONBARK_DEFAULT_SUBDIRS=(
    "bin"
    "data/zarf/init"
    "data/repos"
)

# ------------------------------------------------------------------------------
# FUNCTIONS
# ------------------------------------------------------------------------------

##
 # Prints an informational message to stderr.
 #
 # @param $*
 #          The message to print.
 ##
function print_info() { echo "$(date -Iseconds) INFO: $*" >&2; }

##
 # Prints an error message to stderr and exits the script with a
 # non-zero status code.
 #
 # @param $*
 #          The error message to print.
 ##
function print_error_and_exit()
{
    echo "$(date -Iseconds) ERROR: $*" >&2
    exit 1
}

##
 # Resolves the user that invoked the installer. Prefers `SUDO_USER`
 # (set by sudo) and falls back to `USER`.
 #
 # Echoes the resolved username on stdout.
 ##
function resolve_invoking_user()
{
    if [[ -n "${SUDO_USER:-}" ]]; then
        echo "${SUDO_USER}"
        return 0
    fi
    if [[ -n "${USER:-}" ]]; then
        echo "${USER}"
        return 0
    fi
    print_error_and_exit "Could not resolve invoking user (neither SUDO_USER nor USER is set)."
}

##
 # Resolves the primary group of the given user.
 #
 # @param $1 The username.
 #
 # Echoes the resolved group name on stdout.
 ##
function resolve_user_group()
{
    local _user="${1}"
    local _group
    _group="$(id -gn "${_user}" 2>/dev/null || true)"
    if [[ -z "${_group}" ]]; then
        print_error_and_exit "Could not resolve primary group for user [${_user}]."
    fi
    echo "${_group}"
}

##
 # Creates the install directory tree, including the configured default
 # subdirectories.
 ##
function create_install_tree()
{
    print_info "Creating install directory tree at [${IRONBARK_INSTALL_DIR}]."
    mkdir -p "${IRONBARK_INSTALL_DIR}" \
        || print_error_and_exit "Could not create install directory [${IRONBARK_INSTALL_DIR}]."

    local _subdir
    for _subdir in "${IRONBARK_DEFAULT_SUBDIRS[@]}"; do
        local _path="${IRONBARK_INSTALL_DIR}/${_subdir}"
        mkdir -p "${_path}" \
            || print_error_and_exit "Could not create subdirectory [${_path}]."
    done
}

##
 # Restores ownership of the per-release-environment install directory
 # tree to the invoking user/group. Sibling release-environment trees
 # under the install base directory are left untouched.
 #
 # @param $1 The owner (`<user>:<group>`) to apply.
 ##
function fix_ownership()
{
    local _owner="${1}"
    print_info "Setting ownership of [${IRONBARK_INSTALL_DIR}] to [${_owner}] (recursive)."
    chown -R "${_owner}" "${IRONBARK_INSTALL_DIR}" \
        || print_error_and_exit "Could not chown [${IRONBARK_INSTALL_DIR}] to [${_owner}]."
}

##
 # Applies recursive default ACLs on the per-release-environment install
 # directory granting the invoking user/group rwX, so newly-created
 # files beneath inherit the right permissions. Sibling
 # release-environment trees under the install base directory are left
 # untouched. Silently no-ops if `setfacl` is not available.
 #
 # @param $1 The invoking user.
 # @param $2 The invoking user's primary group.
 ##
function apply_default_acls()
{
    local _user="${1}"
    local _group="${2}"

    if ! command -v setfacl >/dev/null 2>&1; then
        print_info "setfacl not found on PATH - skipping default ACL setup."
        return 0
    fi

    print_info "Applying recursive default ACLs (user=[${_user}], group=[${_group}]) to [${IRONBARK_INSTALL_DIR}]."
    # The `-d` flag sets *default* ACLs that are inherited by new files
    # created under the directory; the second invocation (without `-d`)
    # applies the same rules to existing files so that ownership/perms
    # are consistent immediately.
    #
    # The uppercase `X` (vs lowercase `x`) is deliberate: it grants
    # execute permission only on directories and on files that already
    # have an execute bit set elsewhere in their mode. This avoids
    # making every regular file beneath the install root executable
    # while still leaving directories traversable and existing
    # executables (the launcher, the Zarf binary, etc.) executable.
    setfacl -R -d -m "u:${_user}:rwX,g:${_group}:rwX" "${IRONBARK_INSTALL_DIR}" \
        || print_error_and_exit "Could not set default ACLs on [${IRONBARK_INSTALL_DIR}]."
    setfacl -R    -m "u:${_user}:rwX,g:${_group}:rwX" "${IRONBARK_INSTALL_DIR}" \
        || print_error_and_exit "Could not set ACLs on [${IRONBARK_INSTALL_DIR}]."
}

##
 # Writes the embedded launcher script to the supplied path and makes it
 # executable.
 #
 # @param $1 The path to write the launcher to.
 ##
function write_launcher()
{
    local _path="${1}"
    # The literal launcher script is heredoc'd directly below. The
    # `'EOF'`-style quoting (single-quoted delimiter) ensures NO
    # expansion happens here at install time - the launcher's own
    # variables are resolved when the launcher is executed.
    cat > "${_path}" <<'IRONBARK_INSTALLER_LAUNCHER_EOF'
{{ .LauncherScript }}
IRONBARK_INSTALLER_LAUNCHER_EOF
    chmod a+x "${_path}" \
        || print_error_and_exit "Could not chmod the generated launcher at [${_path}]."
}

##
 # Installs (or upgrades) the launcher script in the install directory's
 # `bin/` subdirectory. Writes the versioned launcher and (re)points the
 # generic `ironbark` symlink at it.
 ##
function install_launcher()
{
    cd "${IRONBARK_BIN_DIR}" \
        || print_error_and_exit "Could not enter launcher bin directory [${IRONBARK_BIN_DIR}]."

    local _launcher_versioned
    _launcher_versioned=".$(date -Iseconds --utc)_ironbark_${IRONBARK_VERSION}"
    print_info "Writing versioned launcher [${IRONBARK_BIN_DIR}/${_launcher_versioned}]."
    write_launcher "${_launcher_versioned}"

    local _launcher_generic="ironbark"
    if [[ -L "${_launcher_generic}" || -e "${_launcher_generic}" ]]; then
        print_info "Replacing existing launcher symlink [${IRONBARK_BIN_DIR}/${_launcher_generic}]."
        rm -f "${_launcher_generic}" \
            || print_error_and_exit "Could not remove existing launcher symlink [${IRONBARK_BIN_DIR}/${_launcher_generic}]."
    fi
    ln -s "${_launcher_versioned}" "${_launcher_generic}" \
        || print_error_and_exit "Could not create launcher symlink [${IRONBARK_BIN_DIR}/${_launcher_generic}] -> [${_launcher_versioned}]."
}

##
 # Entry point.
 ##
function main()
{
    print_info "Installing Ironbark [${IRONBARK_VERSION}] for release environment [${IRONBARK_RELEASE_ENVIRONMENT}]."

    local _user _group
    _user="$(resolve_invoking_user)"
    _group="$(resolve_user_group "${_user}")"
    print_info "Resolved invoking user/group: [${_user}:${_group}]."

    create_install_tree
    install_launcher
    fix_ownership "${_user}:${_group}"
    apply_default_acls "${_user}" "${_group}"

    cat >&2 <<EOF
$(date -Iseconds) INFO: Ironbark version [${IRONBARK_VERSION}] can be launched via:

    ${IRONBARK_BIN_DIR}/ironbark

EOF
}

# ------------------------------------------------------------------------------
# LOGIC
# ------------------------------------------------------------------------------

main "$@"
