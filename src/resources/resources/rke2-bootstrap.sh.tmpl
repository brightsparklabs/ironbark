#!/usr/bin/env bash

##
 # Extracts the RKE2 installation artifacts out of the Ironbark container
 # image, ready for the operator to run the RKE2 installation on the host.
 #
 # Image:            {{ .Image }}
 # Container engine: {{ .Engine }}
 # Source path:      {{ .SourcePath }}
 # Output directory: {{ .OutputDir }}
 # _____________________________________________________________________________
 #
 # Generated by 'ironbark generate rke2-bootstrap' at {{ .GeneratedAt }}.
 #   Ironbark version:    {{ .IronbarkVersion }}
 #   Ironbark commit:     {{ .IronbarkCommit }}
 #   Ironbark build time: {{ .IronbarkBuildTime }}
 #
 # Created by brightSPARK Labs.
 # www.brightsparklabs.com.
 ##

# ------------------------------------------------------------------------------
# EXIT CONDITIONS
# ------------------------------------------------------------------------------

# Exit script on error.
set -o errexit
# Exit if using undeclared variables.
set -o nounset
# Exit if pipe fails.
set -o pipefail

# ------------------------------------------------------------------------------
# VARIABLES
# ------------------------------------------------------------------------------
#
# Resolve each runtime setting from its 'IRONBARK_*' environment
# variable, falling back to the value baked into the script at
# generation time when the env var is unset.

# Container engine to use ('podman' or 'docker').
IRONBARK_SCRIPT_CONTAINER_ENGINE="${IRONBARK_SCRIPT_CONTAINER_ENGINE:-{{ .Engine }}}"

# Container image to extract RKE2 from.
IRONBARK_SCRIPT_IMAGE="${IRONBARK_SCRIPT_IMAGE:-{{ .Image }}}"

# Path inside the container which contains the RKE2 installation artifacts.
IRONBARK_SCRIPT_RKE2_SOURCE_PATH="${IRONBARK_SCRIPT_RKE2_SOURCE_PATH:-{{ .SourcePath }}}"

# Host directory which will receive the extracted RKE2 assets.
IRONBARK_SCRIPT_RKE2_OUTPUT_DIR="${IRONBARK_SCRIPT_RKE2_OUTPUT_DIR:-{{ .OutputDir }}}"

# Print the resolved settings to stderr before invoking the container engine.
# Define 'IRONBARK_SCRIPT_VERBOSE' to ANY value (e.g. 'true', '1') to enable.
: "${IRONBARK_SCRIPT_VERBOSE:=}"

# ------------------------------------------------------------------------------
# FUNCTIONS
# ------------------------------------------------------------------------------

##
 # Prints an informational message to stderr.
 #
 # @param $*
 #          The message to print.
 ##
function print_info() { echo "$(date -Iseconds) INFO: $*" >&2; }

##
 # Prints an error message to stderr.
 #
 # @param $*
 #          The error message to print.
 ##
function print_error() { echo "$(date -Iseconds) ERROR: $*" >&2; }

##
 # Prints a verbose-mode debug message to stderr if
 # 'IRONBARK_SCRIPT_VERBOSE' is defined.
 #
 # @param $*
 #          The message to print.
 ##
function print_verbose() {
    [[ -n "${IRONBARK_SCRIPT_VERBOSE}" ]] && echo "$(date -Iseconds) DEBUG: $*" >&2
    return 0
}

##
 # Entry point.
 #
 # @param $@
 #          Ignored; the script takes no arguments.
 ##
function main() {
    if [[ $# -gt 0 ]]; then
        print_error "This script takes no arguments; got: $*"
        exit 1
    fi

    if ! command -v "${IRONBARK_SCRIPT_CONTAINER_ENGINE}" >/dev/null 2>&1; then
        print_error "Container engine not found on PATH: ${IRONBARK_SCRIPT_CONTAINER_ENGINE}"
        exit 1
    fi

    print_info "Creating output directory: ${IRONBARK_SCRIPT_RKE2_OUTPUT_DIR}"
    if ! mkdir -p "${IRONBARK_SCRIPT_RKE2_OUTPUT_DIR}"; then
        print_error "Could not create output directory: ${IRONBARK_SCRIPT_RKE2_OUTPUT_DIR}"
        exit 1
    fi

    if [[ -n "${IRONBARK_SCRIPT_VERBOSE}" ]]; then
        # Resolved settings table - one row per variable, columns
        # aligned on the longest variable name
        # ('IRONBARK_SCRIPT_RKE2_SOURCE_PATH' at 35 chars).
        print_verbose "Resolved rke2-bootstrap settings (after env-var overrides):"
        local _v _setting
        for _setting in IRONBARK_SCRIPT_CONTAINER_ENGINE \
                        IRONBARK_SCRIPT_IMAGE \
                        IRONBARK_SCRIPT_RKE2_SOURCE_PATH \
                        IRONBARK_SCRIPT_RKE2_OUTPUT_DIR \
                        IRONBARK_SCRIPT_VERBOSE; do
            printf -v _v '  %-37s = %q' "${_setting}" "${!_setting-}"
            print_verbose "${_v}"
        done
    fi

    print_info "Creating throwaway container from image: ${IRONBARK_SCRIPT_IMAGE}"
    local container_id
    container_id="$("${IRONBARK_SCRIPT_CONTAINER_ENGINE}" create "${IRONBARK_SCRIPT_IMAGE}")"
    if [[ -z "${container_id}" ]]; then
        print_error "Could not create container from image: ${IRONBARK_SCRIPT_IMAGE}"
        exit 1
    fi

    # Always remove the throwaway container on exit, regardless of success.
    # shellcheck disable=SC2064
    trap "'${IRONBARK_SCRIPT_CONTAINER_ENGINE}' rm '${container_id}' >/dev/null 2>&1 || true" EXIT

    print_info "Copying RKE2 assets from container: ${container_id}:${IRONBARK_SCRIPT_RKE2_SOURCE_PATH} -> ${IRONBARK_SCRIPT_RKE2_OUTPUT_DIR}"
    # The trailing '/.' makes the engine copy the *contents* of the source
    # directory rather than the directory itself, which is the conventional
    # behaviour expected by users.
    if ! "${IRONBARK_SCRIPT_CONTAINER_ENGINE}" cp "${container_id}:${IRONBARK_SCRIPT_RKE2_SOURCE_PATH}/." "${IRONBARK_SCRIPT_RKE2_OUTPUT_DIR}/"; then
        print_error "Could not copy RKE2 assets from container."
        exit 1
    fi

    print_info "RKE2 assets extracted successfully to: ${IRONBARK_SCRIPT_RKE2_OUTPUT_DIR}"
    print_info ""
    print_info "Next steps:"
    print_info "  1. Review the RKE2 installation script and configuration options:"
    print_info "     less \"${IRONBARK_SCRIPT_RKE2_OUTPUT_DIR}/install.sh\""
    print_info ""
    print_info "  2. Install RKE2 using the extracted artifacts (air-gapped installation):"
    print_info "     cd \"${IRONBARK_SCRIPT_RKE2_OUTPUT_DIR}\""
    print_info "     sudo INSTALL_RKE2_ARTIFACT_PATH=\"${IRONBARK_SCRIPT_RKE2_OUTPUT_DIR}\" ./install.sh"
    print_info ""
    print_info "  3. Configure RKE2 to use Cilium CNI (create /etc/rancher/rke2/config.yaml):"
    print_info "     sudo mkdir -p /etc/rancher/rke2"
    print_info "     sudo tee /etc/rancher/rke2/config.yaml > /dev/null <<EOF"
    print_info "     # Use Cilium as the CNI (required to use the extracted Cilium images)"
    print_info "     cni: cilium"
    print_info "     "
    print_info "     # Make kubeconfig readable by non-root users"
    print_info "     write-kubeconfig-mode: \"0644\""
    print_info "     "
    print_info "     # Additional TLS SANs for API server certificate"
    print_info "     tls-san:"
    print_info "       - localhost"
    print_info "       - 127.0.0.1"
    print_info "     EOF"
    print_info "     # See: https://docs.rke2.io/install/configuration"
    print_info ""
    print_info "  4. Enable and start the RKE2 service:"
    print_info "     # For server node:"
    print_info "     sudo systemctl enable rke2-server.service"
    print_info "     sudo systemctl start rke2-server.service"
    print_info ""
    print_info "     # For agent node:"
    print_info "     sudo systemctl enable rke2-agent.service"
    print_info "     sudo systemctl start rke2-agent.service"
    print_info ""
    print_info "  5. Access the cluster:"
    print_info "     export KUBECONFIG=/etc/rancher/rke2/rke2.yaml"
    print_info "     /var/lib/rancher/rke2/bin/kubectl get nodes"
    print_info ""
    print_info "If your host enforces fapolicyd, generate matching rules with:"
    print_info "  ironbark generate fapolicy-rules > /etc/fapolicyd/rules.d/30-ironbark.rules"
    print_info "  sudo systemctl restart fapolicyd"
}

# ------------------------------------------------------------------------------
# LOGIC
# ------------------------------------------------------------------------------

main "$@"
