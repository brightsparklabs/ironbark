#!/usr/bin/env bash

##
 # Extracts the `zarf` CLI and `zarf-init-*.tar.zst` package out of the
 # Ironbark container image, ready for the operator to run `zarf init` on the
 # host (e.g. when bootstrapping K3s).
 #
 # Image:            {{ .Image }}
 # Container engine: {{ .Engine }}
 # Source path:      {{ .SourcePath }}
 # Output directory: {{ .OutputDir }}
 # _____________________________________________________________________________
 #
 # Generated by `ironbark generate zarf-bootstrap` at {{ .GeneratedAt }}.
 #   Ironbark version:    {{ .IronbarkVersion }}
 #   Ironbark commit:     {{ .IronbarkCommit }}
 #   Ironbark build time: {{ .IronbarkBuildTime }}
 #
 # Created by brightSPARK Labs.
 # www.brightsparklabs.com.
 ##

# ------------------------------------------------------------------------------
# EXIT CONDITIONS
# ------------------------------------------------------------------------------

# Exit script on error.
set -o errexit
# Exit if using undeclared variables.
set -o nounset
# Exit if pipe fails.
set -o pipefail

# ------------------------------------------------------------------------------
# VARIABLES
# ------------------------------------------------------------------------------

# Container engine to use (`podman` or `docker`).
# Override at runtime by exporting `IRONBARK_CONTAINER_ENGINE`.
CONTAINER_ENGINE="${IRONBARK_CONTAINER_ENGINE:-{{ .Engine }}}"

# Container image to extract Zarf from.
# Override at runtime by exporting `IRONBARK_IMAGE`.
IRONBARK_IMAGE="${IRONBARK_IMAGE:-{{ .Image }}}"

# Path inside the container which contains the `zarf` CLI and the
# `zarf-init-*.tar.zst` package.
# Override at runtime by exporting `IRONBARK_ZARF_SOURCE_PATH`.
SOURCE_PATH="${IRONBARK_ZARF_SOURCE_PATH:-{{ .SourcePath }}}"

# Host directory which will receive the extracted Zarf assets.
# Override at runtime by exporting `IRONBARK_ZARF_OUTPUT_DIR`.
OUTPUT_DIR="${IRONBARK_ZARF_OUTPUT_DIR:-{{ .OutputDir }}}"

# Print the resolved settings to stderr before invoking the container engine.
# Define `IRONBARK_VERBOSE` to ANY value (e.g. `true`, `1`) to enable.
VERBOSE="${IRONBARK_VERBOSE-}"

# ------------------------------------------------------------------------------
# FUNCTIONS
# ------------------------------------------------------------------------------

##
 # Prints an informational message to stderr.
 #
 # @param $*
 #          The message to print.
 ##
function print_info() { echo "$(date -Iseconds) INFO: $*" >&2; }

##
 # Prints an error message to stderr.
 #
 # @param $*
 #          The error message to print.
 ##
function print_error() { echo "$(date -Iseconds) ERROR: $*" >&2; }

##
 # Prints a verbose-mode debug message to stderr if `VERBOSE` is defined.
 #
 # @param $*
 #          The message to print.
 ##
function print_verbose() {
    [[ -n "${VERBOSE}" ]] && echo "$(date -Iseconds) DEBUG: $*" >&2
    return 0
}

##
 # Entry point.
 #
 # @param $@
 #          Ignored; the script takes no arguments.
 ##
function main() {
    if [[ $# -gt 0 ]]; then
        print_error "This script takes no arguments; got: $*"
        exit 1
    fi

    if ! command -v "${CONTAINER_ENGINE}" >/dev/null 2>&1; then
        print_error "Container engine not found on PATH: ${CONTAINER_ENGINE}"
        exit 1
    fi

    print_info "Creating output directory: ${OUTPUT_DIR}"
    if ! mkdir -p "${OUTPUT_DIR}"; then
        print_error "Could not create output directory: ${OUTPUT_DIR}"
        exit 1
    fi

    if [[ -n "${VERBOSE}" ]]; then
        print_verbose "Extracting Zarf with the following settings:"
        print_verbose "  CONTAINER_ENGINE = ${CONTAINER_ENGINE}"
        print_verbose "  IRONBARK_IMAGE   = ${IRONBARK_IMAGE}"
        print_verbose "  SOURCE_PATH      = ${SOURCE_PATH}"
        print_verbose "  OUTPUT_DIR       = ${OUTPUT_DIR}"
    fi

    print_info "Creating throwaway container from image: ${IRONBARK_IMAGE}"
    local container_id
    container_id="$("${CONTAINER_ENGINE}" create "${IRONBARK_IMAGE}")"
    if [[ -z "${container_id}" ]]; then
        print_error "Could not create container from image: ${IRONBARK_IMAGE}"
        exit 1
    fi

    # Always remove the throwaway container on exit, regardless of success.
    # shellcheck disable=SC2064
    trap "'${CONTAINER_ENGINE}' rm '${container_id}' >/dev/null 2>&1 || true" EXIT

    print_info "Copying Zarf assets from container: ${container_id}:${SOURCE_PATH} -> ${OUTPUT_DIR}"
    # The trailing `/.` makes the engine copy the *contents* of the source
    # directory rather than the directory itself, which is the conventional
    # behaviour expected by users.
    if ! "${CONTAINER_ENGINE}" cp "${container_id}:${SOURCE_PATH}/." "${OUTPUT_DIR}/"; then
        print_error "Could not copy Zarf assets from container."
        exit 1
    fi

    print_info "Zarf assets extracted successfully to: ${OUTPUT_DIR}"
    print_info "Next steps:"
    print_info "  cd \"${OUTPUT_DIR}\""
    print_info "  sudo ./zarf init"
    print_info ""
    print_info "If your host enforces fapolicyd, generate matching rules with:"
    print_info "  ironbark generate fapolicy-rules > /etc/fapolicyd/rules.d/30-ironbark.rules"
    print_info "  sudo systemctl restart fapolicyd"
}

# ------------------------------------------------------------------------------
# LOGIC
# ------------------------------------------------------------------------------

main "$@"
